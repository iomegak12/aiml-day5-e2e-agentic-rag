# Build context filter for Docker and Podman (Podman reads .dockerignore when there is no .containerignore).
# Keep secrets, data, local environments and non-runtime files out of the image.
.env
.env.*
!.env.example
.git
.gitignore
.venv
__pycache__/
*.py[oc]
.pytest_cache/
*.egg-info
build/
dist/

# data and volumes
chroma-data/
redis-data/
pg-data/
data/
logs/

# not needed at runtime
docs/
notebooks/
archives/
api/tests/
tests/
*.md
!README.md
Makefile
compose.yaml
Containerfile
.dockerignore

# Copy to .env and fill in your values:  cp .env.example .env
# .env is git-ignored - never commit real keys.

# OpenAI API key used by scripts/generate_kb.py (via langchain-openai)
OPENAI_API_KEY=sk-your-key-here

# Chat model used to write the KB articles (any model that supports structured output)
OPENAI_MODEL=gpt-5.5

# Embedding model used by scripts/populate_vector_dbs.py
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pre-RAG pipeline (scripts/populate_vector_dbs.py) ---
# Root folder with one sub-folder per domain (networking/, meetings/)
KB_DATA_DIR=data/raw
# Chroma server (started with `make chroma-up`)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_TENANT=default_tenant
# One Chroma database per domain, one collection per database
CHROMA_DB_NETWORKING=networking_kb
CHROMA_DB_MEETINGS=meetings_kb
CHROMA_COLLECTION=kb_articles
# Size-based chunking (characters)
CHUNK_SIZE=3000
CHUNK_OVERLAP=200
# Parallel LLM calls for table/code descriptions
DESCRIBE_CONCURRENCY=8

# --- Agentic RAG agent (scripts/agentic_rag) ---
# Web search (https://serper.dev)
SERPER_API_KEY=your-serper-key
# Cheaper/faster model for reranking, guardrail checks, query rewriting and context summaries
RERANKER_OPENAI_MODEL=gpt-5.1
# Judge model (LLM-as-a-judge: faithfulness, groundedness, context precision)
JUDGE_OPENAI_MODEL=gpt-6.1-sol
# Reasoning effort for reasoning judge models (low | medium | high); empty for non-reasoning models
JUDGE_REASONING_EFFORT=low
# Redis Stack semantic cache (started with `make redis-up`)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
CACHE_NAME=netcore_rag_cache
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=86400
# Retrieval, rerank relevance and RAGAS judge thresholds (0-1)
RETRIEVAL_K=6
RELEVANCE_THRESHOLD=0.6
FAITHFULNESS_THRESHOLD=0.7
GROUNDEDNESS_THRESHOLD=0.7
CONTEXT_PRECISION_THRESHOLD=0.6
# Context optimizer budget (tokens) and agent limits
CONTEXT_TOKEN_BUDGET=6000
MAX_REWRITES=3
MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=90
# Planning mode (Plan-and-Execute): maximum steps per (re-)plan
MAX_PLAN_STEPS=4

# --- REST API (api/) ---
# API key -> demo user (alice=guest, bob=employee, carol=admin). Format: key:user,key:user
API_KEYS=change-me-guest:alice,change-me-employee:bob,change-me-admin:carol
API_PORT=8080
# Postgres (audit log + agent runs). Started with `make db-up`; the API container overrides the host.
POSTGRES_USER=netcore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netcore_api
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://netcore:change-me@localhost:5432/netcore_api
# Rate limit per client IP: requests per minute; on breach the IP is blocked for N seconds
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BLOCK_SECONDS=30
# Only behind a reverse proxy you control: take the client IP from X-Forwarded-For
# (compose sets it to true for the api container, which sits behind the web/Nginx gateway)
TRUST_PROXY_HEADERS=false
# Agent time budget per request (seconds): default and bounds; hard cap = budget + grace
API_TIMEOUT_DEFAULT=120
API_TIMEOUT_MIN=10
API_TIMEOUT_MAX=300
API_TIMEOUT_GRACE=15
AGENT_MAX_CONCURRENCY=4
# Replayable SSE event buffer (Redis Streams), seconds
EVENT_BUFFER_TTL_SECONDS=3600
# JSON logs: console + rotating file
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# --- Web UI (web/) ---
# Host port of the web container (Nginx gateway: UI + /api proxy). Rootless Podman cannot bind ports < 1024
# by default: use WEB_PORT=3000 or allow it (see TROUBLESHOOTING.md).
WEB_PORT=80

# --- MCP server (netcore_mcp/) - IT support tickets: Postgres (schema itsm) + Jira Cloud mirror ---
# Bind address and port (streamable HTTP endpoint: http://<host>:<port>/mcp). No authentication yet.
MCP_HOST=0.0.0.0
MCP_PORT=9090
# Where the agent reaches the server (compose sets http://mcp:9090/mcp for the api container)
MCP_SERVER_URL=http://localhost:9090/mcp
# Seconds before the agent retries loading the ticket tools after the server was unreachable
MCP_RETRY_SECONDS=30
# Jira Cloud site, account e-mail and API token (Basic auth = e-mail + token; id.atlassian.com > Security > API tokens)
ATLASSIAN_SITE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=
# Jira project ("My IT Team" = KAN), issue type and the transition used by resolve_ticket
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Incident
JIRA_RESOLVE_TRANSITION=Resolved
# Background retry of tickets whose Jira sync is pending (seconds; 0 = off - use the sync_pending_tickets tool)
JIRA_SYNC_INTERVAL_SECONDS=60

# --- Publish (make publish) + AWS deployment (make iac-*; Terraform in iac/) ---
# Docker Hub user that owns the images, and a personal access token (read & write) - never your password
DOCKERHUB_USERNAME=iomega
DOCKERHUB_TOKEN=
# AWS credentials for Terraform (standard names); they are NOT uploaded to the instance
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

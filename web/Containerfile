# NetCore Assist web UI: React build served by non-root Nginx, which also proxies the API (same origin).
#   docker build -f Containerfile -t localhost/netcore-rag-web:0.8.0 .
#   podman build -f Containerfile --format docker -t localhost/netcore-rag-web:0.8.0 .   (keeps HEALTHCHECK)
# Build context: web/ (see web/.dockerignore).

# ---------------------------------------------------------------- build
FROM docker.io/library/node:22.22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# ---------------------------------------------------------------- runtime
FROM docker.io/nginxinc/nginx-unprivileged:1.30.6-alpine AS runtime
LABEL org.opencontainers.image.title="netcore-rag-web" \
      org.opencontainers.image.description="NetCore Assist web UI (React + Nginx gateway)" \
      org.opencontainers.image.version="0.8.0"

COPY --chown=nginx:nginx nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --chown=nginx:nginx nginx/proxy.conf nginx/security-headers.conf /etc/nginx/snippets/
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

USER nginx
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Chroma server data (docker bind mount)
chroma-data/

# Jupyter
.ipynb_checkpoints/

# Redis semantic cache data (docker bind mount)
redis-data/

# Legacy bind-mount data (archived docker-compose.yml); compose.yaml uses named volumes
# (chroma-data/ and redis-data/ above stay ignored until you delete those folders)
pg-data/

# API logs and test caches
logs/
.pytest_cache/

# make TUI run history (uv run tui.py)
.make_tui_history.json

# Terraform (iac/): providers, local state (contains the generated private key), keys, build inputs
iac/.terraform/
iac/*.tfstate
iac/*.tfstate.*
iac/.keys/
iac/.build/
iac/*.tfvars
iac/crash.log
